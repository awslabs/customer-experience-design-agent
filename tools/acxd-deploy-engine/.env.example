# ACXD Deploy Engine — environment file.
# THE ONLY .env TEMPLATE. ONE file for ALL deploy stages, at the distribution root. It already contains every
# key the engine, the backend and the Connect CDK app read — do not author or merge any other .env.example.
# Keys are ordered by WHEN they are filled (top-to-bottom = the order the runbook fills them). The engine fills
# the CREATE-ME ids for you. Edit values here; never pass them on the command line.
#
# PREREQUISITE: an AWS account with an EXISTING Amazon Connect instance you have admin access to. This solution
# never creates the instance. The ACXD API key below is generated from that instance.

# ── Prerequisites — your AWS account, Amazon Connect instance and ACXD API key ──

#   The ONE region for the whole solution — the ACXD workspace/application, the Amazon Connect instance, AND
#   any API this solution deploys (or adapter) all deploy here. The engine and the Connect CDK app read it from this file;
#   the mock/adapter CDK takes the same value as --context region=<this value>. ACXD supports 9 regions
#   (us-east-1, us-west-2, ap-northeast-1/2, ap-southeast-1, ap-southeast-2, ca-central-1, eu-central-1, eu-west-2).
AWS_REGION=

#   The canonical camelCase projectName from CX Discovery. Names the Connect stack
#   acxd-<projectName>-<env>-connect, so it MUST be identical on every run (a different value = a new stack).
ACXD_PROJECT_NAME=

#   Environment suffix for the Connect stack name. Default dev. Keep it identical across runs.
ACXD_ENVIRONMENT=dev

#   ARN of your EXISTING Amazon Connect instance (same region as AWS_REGION), e.g.
#   arn:aws:connect:<region>:<account>:instance/<uuid>. Find it in the Amazon Connect console → your instance →
#   Overview. The contact flow is wired into this instance; it is never created or deleted by this solution.
CONNECT_INSTANCE_ARN=

#   Your ACXD API key — generated by hand from your Connect instance: open Agentic CX Designer → Admin Hub →
#   Programmatic Users → Generate API Key. Form acxd_live_<prefix>.<secret>, shown once. Keep it here only;
#   never commit it. There is no automated path for this step. The engine needs it in Stage 2.
ACXD_API_TOKEN=

# ── Stage 1 — APIs: base URL and credential for each API the data requests call ──
#   One entry per API, written from the OpenAPI files by the API wiring tool. APIs this solution deploys: the URL
#   comes from the Stage 1 stack output and the key is generated in Backend Build. Your own APIs: the URL is pre-filled from
#   the OpenAPI servers entry; enter the credential your provider issued. Credentials stay in this file only.
# >>> acxd-apis (generated from the OpenAPI files by openapi-wiring; do not edit inside these markers by hand)
# <<< acxd-apis

# ── Stage 2 — ACXD engineer: logging level (ACXD_API_TOKEN is filled in Prerequisites, above) ──

#   stages  = one line per object TYPE ("Creating context variables…")
#   objects = one line per object created ("✓ contextVariable ctxAuthenticated")   [default]
#   debug   = full detail: request params, responses, ids, poll ticks, settle delays, raw build/deploy status
ACXD_LOG_LEVEL=objects

# ── Stage 2 — ApplicationSettings — used ONLY when CREATING a new Application
#    (ignored if ACXD_APPLICATION_ID is set / reused). Edit as needed. ──

#   examples (SDK supports ~90): en-US, en-GB, en-AU, es-US, es-ES, fr-FR, fr-CA, de-DE, pt-BR, ja-JP
#   NOTE: ACXD_APP_CHANNELS is not currently applied — "channels" is not an ApplicationSettings field in
#   this SDK version (0.1.0). Left out deliberately; channel behaviour is handled in the flows / Connect.
ACXD_APP_DEFAULT_LANGUAGE=en-US

#   idle session timeout (SECONDS) → engine converts to settings.conversationTTL, which is in MINUTES (max
#   1440 = 24h). 1800s → 30 min. e.g. 300, 600, 900, 1800, 3600 (values over 86400s clamp to the 1440-min cap).
ACXD_APP_SESSION_TIMEOUT_SECONDS=1800

# ══ Workspace & Application ══════════════════════════════════════════════════════════════════
#  Choose ONE path — fill the IDs to REUSE, or the NAMES to CREATE. Do NOT fill both for a resource:
#  if an *_ID is set, the matching *_NAME is IGNORED.
#
#  Managing change across runs: set the IDs to UPDATE an existing workspace/application in place (iterate on
#  one solution); leave IDs blank + set NAMES to CREATE a fresh one per run (compare versions side by side).
#  IMPORTANT — resources (context vars, slots, secrets, data requests, knowledge bases) are scoped to the
#  WORKSPACE, not the application. Re-deploying into the SAME workspace re-applies those resources (a re-run
#  updates/collides with the existing ones) even under a different application. For a clean, isolated version,
#  create a NEW workspace.
#
#  ── PATH A · REUSE existing resources → fill the IDs (leave the NAMES below blank) ──
#     Paste the ids of a workspace/application that already exists. Nothing is created.
ACXD_WORKSPACE_ID=
ACXD_APPLICATION_ID=
#
#  ── PATH B · CREATE new resources → fill the NAMES (leave the IDs above blank) ──
#     The deploy creates each resource with the name given and writes its new id back into the *_ID line
#     above automatically (so the next re-run reuses it). Pre-filled with a use-case default — edit to rename.
#     NAME constraints (ACXD-enforced — a bad name fails the create):
#       • Application name: letters, digits, spaces, hyphen (-) and underscore (_) only; length 1–100.
#         Pattern ^[A-Za-z0-9 _-]+$ — e.g. "Northwind Energy Billing" or "northwindEnergyBillingApp" are both valid.
#       • Workspace name: same friendly rule recommended (letters/digits/space/-/_; keep ≤100 chars).
#       • No other punctuation or symbols; must not be empty.
ACXD_WORKSPACE_NAME=
ACXD_APPLICATION_NAME=
# ═════════════════════════════════════════════════════════════════════════════════════════════

# ── Stage 3 — Connect/telephony engineer: Amazon Connect integration ──
#    Read by backend/connect/cdk/app.ts, which loads THIS file itself. Run it
#    LAST, after the ACXD SDK stage, with `npm run deploy`. It wires into the instance in CONNECT_INSTANCE_ARN.

#   The ACXD application deployment key the Agentic CX block uses (ACXD console → your application → Deployment
#   key, after the manual build/deploy review gate). Maps to the mainflow.json Alias.
ACXD_DEPLOYMENT_KEY=

#   Optional — an EXISTING Connect queue ARN for human hand-off. Leave blank and the stack CREATES an
#   escalation queue + routing profile for you.
ESCALATION_QUEUE_ARN=

#   Required when ESCALATION_QUEUE_ARN is blank (the stack creates the queue). The ARN of an EXISTING hours of
#   operation in your instance, e.g. the built-in "Basic Hours". Ids are per-instance UUIDs, so there is no
#   default. Find it (instance id = last segment of CONNECT_INSTANCE_ARN):
#     aws connect list-hours-of-operations --instance-id <instance-id> --region <AWS_REGION> \
#       --query "HoursOfOperationSummaryList[?Name=='Basic Hours'].Arn" --output text
#   Form: arn:aws:connect:<region>:<account>:instance/<instance-id>/operating-hours/<id>
HOURS_OF_OPERATION_ARN=

#   Optional — a sample customer id passed to the Agentic CX block for demo/testing.
ACXD_SAMPLE_CUSTOMER_ID=
