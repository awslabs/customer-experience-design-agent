{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "main.ts",
    "validate-config-cli.ts",
    "trace-cli.ts",
    "openapi-wiring-cli.ts",
    "lib/**/*.ts",
    "steps/**/*.ts",
    "flow-dsl/*.ts"
  ]
}