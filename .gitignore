# ==============================================================================
# .gitignore: Customer Experience (CX) Design Agent (AI-DLC plugin)
# Install: see INSTALL.md. The plugin tooling resolves the plugin by the folder name `acxd`,
# so the source folder is renamed to `acxd` before it is built.
# ==============================================================================

# --- Node / npm (deploy engine, mock backend CDK, template CDK apps, sdk) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json.bak

# --- AWS CDK build output (mock-backend, adapter-integration, connect) ---
cdk.out/
*.cdk.staging/
.cdk.staging/

# --- Plugin build / compose output (regenerated by aidlc-plugin-build) ---
dist/

# --- Secrets / environment — NEVER commit real values ---
# Keep the *.env.example templates (they are the shareable, value-less references);
# ignore any real .env the operator fills in with tokens / keys / URLs.
.env
.env.*
!.env.example
!*.env.example

# --- Python tooling (converters, mock handler, tests) ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# --- TypeScript / build intermediates ---
*.tsbuildinfo

# --- macOS / editor cruft ---
.DS_Store
.AppleDouble
.LSOverride
*.swp
*~
.idea/
.vscode/

# --- Logs / temp ---
*.log
tmp/
.tmp/

# DSL sanity-check output (regenerated on run, never shipped)
tools/acxd-deploy-engine/flow-dsl/examples/_out/

# Local security review working files and scan output (not part of the release)
security-review/
security-evidence/
aws-docs/
logs/
.agents/
